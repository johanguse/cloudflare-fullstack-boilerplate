{
	"$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"formatWithErrors": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "warn",
				"noArrayIndexKey": "off"
			},
			"complexity": {
				"noForEach": "warn"
			},
			"style": {
				"noNonNullAssertion": "warn",
				"noParameterAssign": "error",
				"useAsConstAssertion": "error",
				"useDefaultParameterLast": "error",
				"useEnumInitializers": "error",
				"useSelfClosingElements": "error",
				"useSingleVarDeclarator": "error",
				"noUnusedTemplateLiteral": "error",
				"useNumberNamespace": "error",
				"noInferrableTypes": "error",
				"noUselessElse": "error"
			},
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe"
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all",
			"semicolons": "always"
		}
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/.agents/skills",
			"!**/.claude/skills",
			"!**/skills-lock.json",
			"!**/dist",
			"!**/node_modules",
			"!**/public",
			"!**/worker-configuration.d.ts",
			"!**/src/client/routeTree.gen.ts",
			"!**/src/server/db/migrations"
		]
	},
	"tailwind": {
		"stylesheet": "./src/client/index.css",
		"attributes": ["class", "className", "classList"],
		"mergeFunctions": ["clsx", "tw", "cn"],
		"variantFunctions": ["cva"]
	}
}
