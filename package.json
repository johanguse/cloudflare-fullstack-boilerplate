{
	"name": "cloudflare-boilerplate",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"cf:dev": "wrangler dev",
		"cf:typegen": "wrangler types",
		"build": "vitest run --config vitest.config.ts && tsc -b && vite build",
		"build:staging": "CLOUDFLARE_ENVIRONMENT=staging tsc -b && CLOUDFLARE_ENVIRONMENT=staging vite build",
		"build:production": "CLOUDFLARE_ENVIRONMENT=production tsc -b && CLOUDFLARE_ENVIRONMENT=production vite build",
		"cf:deploy:staging": "rm -rf dist && bun run build:staging && wrangler deploy --env staging --config ./wrangler.jsonc",
		"cf:deploy:production": "rm -rf dist && bun run build:production && wrangler deploy --env production --config ./wrangler.jsonc",
		"lint": "biome lint .",
		"lint:write": "biome lint --write .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"preview": "vite preview",
		"generate-routes": "tsr generate",
		"knip": "knip",
		"test": "vitest run --config vitest.config.ts",
		"i18n:lint": "i18next-cli lint",
		"i18n:extract": "i18next-cli extract",
		"i18n:extract:watch": "i18next-cli extract --watch",
		"i18n:sync": "i18next-cli sync",
		"i18n:watch": "i18next-cli watch",
		"i18n:types": "i18next-cli types",
		"i18n:status": "i18next-cli status",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply speedints-db --local",
		"db:migrate:staging": "wrangler d1 migrations apply speedints-db-staging --env staging --remote",
		"db:migrate:production": "wrangler d1 migrations apply speedints-db-production --env production --remote",
		"db:seed:local": "bun src/server/db/seed.ts local",
		"db:seed:staging": "bun src/server/db/seed.ts staging",
		"db:seed:production": "bun src/server/db/seed.production.ts",
		"db:studio": "drizzle-kit studio",
		"secrets:upload": "bash scripts/upload-secrets.sh both",
		"secrets:upload:staging": "bash scripts/upload-secrets.sh staging",
		"secrets:upload:production": "bash scripts/upload-secrets.sh production",
		"secrets:list:staging": "wrangler secret list --env staging",
		"secrets:list:production": "wrangler secret list --env production",
		"doctor": "npx react-doctor@latest"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@better-auth/drizzle-adapter": "^1.6.23",
		"@hono/swagger-ui": "^0.5.3",
		"@hono/trpc-server": "^0.3.4",
		"@hono/zod-openapi": "^0.19.10",
		"@hono/zod-validator": "^0.7.6",
		"@hookform/resolvers": "^5.4.0",
		"@marsidev/react-turnstile": "^1.5.3",
		"@scalar/hono-api-reference": "^0.9.48",
		"@sentry/cloudflare": "^10.63.0",
		"@sentry/react": "^10.63.0",
		"@tailwindcss/vite": "^4.3.2",
		"@tanstack/react-form": "^1.33.0",
		"@tanstack/react-query": "^5.101.2",
		"@tanstack/react-router": "^1.170.16",
		"@trpc/client": "^11.18.0",
		"@trpc/react-query": "^11.18.0",
		"@trpc/server": "^11.18.0",
		"@trpc/tanstack-react-query": "^11.18.0",
		"better-auth": "^1.6.23",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.27",
		"i18next": "^25.10.10",
		"i18next-browser-languagedetector": "^8.2.1",
		"input-otp": "^1.4.2",
		"lucide-react": "^0.544.0",
		"posthog-js": "^1.396.3",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-hook-form": "^7.80.0",
		"react-i18next": "^15.7.4",
		"react-joyride": "^3.1.0",
		"recharts": "^3.9.1",
		"sonner": "^2.0.7",
		"stripe": "^22.3.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.2",
		"uuid": "^13.0.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.0.6",
		"@cloudflare/vite-plugin": "1.42.2",
		"@cloudflare/vitest-pool-workers": "^0.16.20",
		"@sentry/vite-plugin": "^5.3.0",
		"@tanstack/react-query-devtools": "^5.101.2",
		"@tanstack/react-router-devtools": "^1.167.0",
		"@tanstack/router-plugin": "^1.168.18",
		"@types/node": "22.15.21",
		"@types/react": "19.0.10",
		"@types/react-dom": "19.1.5",
		"@types/uuid": "^11.0.0",
		"@vitejs/plugin-react": "6.0.3",
		"drizzle-kit": "^0.31.10",
		"i18next-cli": "^1.64.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.8.3",
		"vite": "8.1.0",
		"vitest": "~4.1.9",
		"wrangler": "^4.106.0"
	},
	"packageManager": "bun@1.2.17",
	"trustedDependencies": [
		"@biomejs/biome",
		"@tailwindcss/oxide"
	]
}
